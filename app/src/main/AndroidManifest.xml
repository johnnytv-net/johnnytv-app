<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        So an update can be installed from inside the app. A television box
        usually has no browser to hand the download link to, and without this
        the only way to update is somebody arriving with a USB stick.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".JohnnyTvApp"
        android:allowBackup="true"
        android:largeHeap="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".LoginActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SyncActivity"
            android:screenOrientation="sensorLandscape" android:exported="false" />

        <activity android:name=".HomeActivity"
            android:screenOrientation="sensorLandscape" android:exported="false" />

        <activity
            android:name=".BrowseActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".SeriesActivity"
            android:screenOrientation="sensorLandscape" android:exported="false" />

        <activity android:name=".EpgActivity"
            android:screenOrientation="sensorLandscape" android:exported="false" />

        <activity android:name=".SettingsActivity"
            android:screenOrientation="sensorLandscape" android:exported="false" />

        <activity
            android:name=".PlayerActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/AppTheme.Fullscreen" />


        <!--
            Lets the package installer read the downloaded APK out of our cache
            without the file itself ever being world-readable.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
