<?xml version="1.0" encoding="utf-8"?>
<!--
    For logos drawn in white.

    A good many channel logos are white on transparent, meant for a dark
    programme guide. On the white plate the others need, they vanish entirely -
    which is why MSG and its neighbours looked like empty boxes. These get a
    dark plate instead, chosen from the picture itself once it has loaded.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#22252B" />
    <corners android:radius="4dp" />
</shape>
