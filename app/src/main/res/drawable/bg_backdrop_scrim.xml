<?xml version="1.0" encoding="utf-8"?>
<!--
    Over the newspaper, under everything else.

    Dark at the top and bottom where the bar and the tiles sit, lighter through
    the middle so the saucer and the beam are properly visible. Without it the
    white tile text sits on a pale newspaper and cannot be read from a sofa.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#D9000000"
        android:centerColor="#4D000000"
        android:endColor="#E6000000"
        android:type="linear" />
</shape>
