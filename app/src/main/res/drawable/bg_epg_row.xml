<?xml version="1.0" encoding="utf-8"?>
<!--
    A channel row in the guide. Being the selected row is shown by the number and
    name turning blue, not by filling the row - a fill behind blue text is what
    made the old guide look muddy. The row is never focusable, so there is
    deliberately no focused state here.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#22FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
