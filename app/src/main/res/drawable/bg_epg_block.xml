<?xml version="1.0" encoding="utf-8"?>
<!--
    A programme in the guide. Rounded, no outline, and sitting just above the
    background so the grid reads as rows without any lines being drawn.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/epg_block_focused" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/epg_block_focused" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- On air now: lifted a shade, so the current column stands out at a glance. -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/epg_block_on_air" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/epg_block" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
