<?xml version="1.0" encoding="utf-8"?>
<!-- A game on today: the row that is worth pressing. Green edge, lifted tint. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_primary" />
            <corners android:radius="10dp" />
            <stroke android:width="3dp" android:color="@color/brand_accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_primary" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF10332B" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/brand_accent" />
        </shape>
    </item>
</selector>
