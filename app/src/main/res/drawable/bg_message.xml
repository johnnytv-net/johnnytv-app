<?xml version="1.0" encoding="utf-8"?>
<!--
    The card a message from JohnnyTV sits in on the home screen.

    Brand blue rather than the warning gold the renewal notice uses: this is the
    provider talking, not something going wrong, and the two should never be
    mistaken for one another at a glance. Flat fill rather than a gradient -
    large gradients band visibly on television panels.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1F2E7DF7" />
    <stroke android:width="1dp" android:color="#662E7DF7" />
    <corners android:radius="12dp" />
</shape>
