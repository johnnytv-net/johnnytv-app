<?xml version="1.0" encoding="utf-8"?>
<!--
    Over the film's own backdrop. Solid at the left where the writing is, clearing
    towards the right so the picture still shows - without it, white text on a
    bright still is unreadable.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="#F2000000"
        android:centerColor="#CC000000"
        android:endColor="#66000000"
        android:type="linear" />
</shape>
