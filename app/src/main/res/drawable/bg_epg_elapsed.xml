<?xml version="1.0" encoding="utf-8"?>
<!--
    How far through the highlighted programme we are. A hairline, because it sits
    between the times and the length and must not compete with either.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#FF2B333D" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#FFC6CED8" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
</layer-list>
