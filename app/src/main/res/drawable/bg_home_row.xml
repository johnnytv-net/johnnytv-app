<?xml version="1.0" encoding="utf-8"?>
<!-- One of the three main rows on the home screen. Filled blue with the green
     outline when the remote is on it, so there is never a doubt where you are. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_primary" />
            <corners android:radius="14dp" />
            <stroke android:width="3dp" android:color="@color/brand_accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_primary" />
            <corners android:radius="14dp" />
            <stroke android:width="3dp" android:color="@color/brand_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#40FFFFFF" />
        </shape>
    </item>
</selector>
