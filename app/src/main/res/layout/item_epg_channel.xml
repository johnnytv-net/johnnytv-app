<?xml version="1.0" encoding="utf-8"?>
<!--
    One channel down the left of the guide: number, logo, name.
    The row turns brand blue when the panel above is describing it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/epg_row_height"
    android:background="@drawable/bg_epg_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="10dp">

    <TextView
        android:id="@+id/channelNumber"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:ellipsize="none"
        android:fontFamily="sans-serif-medium"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/epg_number_text"
        android:textSize="15sp" />

    <!--
        The logo, with the channel's initials behind it.

        Plenty of channels come with no logo at all, and an empty white plate
        beside a name reads as something broken. The initials sit underneath and
        show through whenever the picture is missing or fails to arrive, so
        every row looks deliberate.
    -->
    <FrameLayout
        android:id="@+id/channelPlate"
        android:layout_width="38dp"
        android:layout_height="26dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_logo_tile">

        <TextView
            android:id="@+id/channelInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:padding="2dp"
            android:textColor="#3A3A3A"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/channelLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/live_tv"
            android:padding="3dp"
            android:scaleType="centerInside" />
    </FrameLayout>

    <TextView
        android:id="@+id/channelName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"
        android:maxLines="1"
        android:textColor="@color/epg_channel_text"
        android:textSize="13.5sp" />
</LinearLayout>
