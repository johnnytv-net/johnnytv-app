<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        app:show_subtitle_button="true" />

    <TextView
        android:id="@+id/playerNowPlaying"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="18dp"
        android:background="#B3000000"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="520dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/playerChannel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="18dp"
        android:background="#B3000000"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:maxWidth="420dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <!--
        On while something is being recorded, wherever the viewer has wandered
        to. A recording that leaves no trace on screen is one somebody discovers
        three days later when the box is full.
    -->
    <TextView
        android:id="@+id/playerRecording"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="18dp"
        android:background="#CC000000"
        android:drawablePadding="8dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:text="@string/recording_badge"
        android:textAllCaps="true"
        android:textColor="#FFFF5A5A"
        android:textSize="13sp"
        android:visibility="gone" />

    <include
        android:id="@+id/playerLoading"
        layout="@layout/view_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/playerStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#AA000000"
        android:padding="16dp"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>
