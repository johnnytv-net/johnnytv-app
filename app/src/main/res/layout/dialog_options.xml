<?xml version="1.0" encoding="utf-8"?>
<!--
    A menu built from real buttons.

    AlertDialog's own list is a ListView, which on a television opens with no
    highlight and often refuses to take one - the remote clicks and nothing
    moves. A column of focusable rows has none of that: the first one is lit
    when it opens, up and down walk it, OK picks it.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/optionsColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</ScrollView>
