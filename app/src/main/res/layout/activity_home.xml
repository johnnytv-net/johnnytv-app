<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_base" android:orientation="vertical" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_topbar" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <ImageView android:layout_width="wrap_content" android:layout_height="40dp" android:adjustViewBounds="true" android:contentDescription="@string/app_name" android:src="@drawable/logo"/>
        <!--
        Date, time, weather and city, together in the middle. They answer
        the same sort of question - what is it now, where am I - so they
        read as one line rather than four scattered facts.
    -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
            <TextView android:id="@+id/homeDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="18sp"/>
            <TextView android:id="@+id/homeClock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="22dp" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:id="@+id/homeWeatherIcon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="22dp" android:textColor="@color/text_primary" android:textSize="17sp" android:visibility="gone"/>
            <TextView android:id="@+id/homeWeatherNow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:textColor="@color/text_primary" android:textSize="17sp" android:visibility="gone"/>
            <TextView android:id="@+id/homeWeatherTown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/text_secondary" android:textSize="14sp" android:visibility="gone"/>
        </LinearLayout>
        <!--
        The renewal date, alone at the far right in yellow. Nothing competes
        with it there, and a customer who sees it for a fortnight renews
        instead of ringing on the night it lapses.
    -->
        <TextView android:id="@+id/homeExpiry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:minWidth="90dp" android:gravity="end" android:textColor="@color/warning" android:textSize="14sp" android:visibility="gone"/>
    </LinearLayout>
    <!--
    A message from JohnnyTV, set in config.json and shown until it is read.
    Hidden entirely when there is nothing to say, so the home screen is not
    carrying an empty box around the rest of the time.
-->
    <LinearLayout android:id="@+id/homeMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_message" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:visibility="gone">
        <View android:layout_width="4dp" android:layout_height="match_parent" android:layout_marginEnd="16dp" android:minHeight="34dp" android:background="@drawable/bg_message_accent"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <!--
            The headline. Sized to be read from a sofa rather than a desk -
            this is the one thing on the screen the customer has not seen
            before, so it is allowed to be the largest text on it.
        -->
            <TextView android:id="@+id/homeMessageText" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold"/>
            <!-- The rest of the sentence, when there is one. -->
            <TextView android:id="@+id/homeMessageDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="2" android:textColor="@color/text_secondary" android:textSize="14sp" android:visibility="gone"/>
        </LinearLayout>
        <TextView android:id="@+id/homeMessageDismiss" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:background="@drawable/bg_message_button" android:focusable="true" android:nextFocusDown="@id/tileLive" android:nextFocusRight="@id/homeMessageDismiss" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="@string/message_got_it" android:textColor="@color/text_primary" android:textSize="14sp"/>
    </LinearLayout>
    <!--
    THE HOME SCREEN, TWO HALVES.

    On the left, the three things people come here for - Live TV, Series,
    Movies - as large rows that say what they are and how much is in them, and
    under them every other destination with its name beside its icon. On the
    right, the artwork: something recently added, to look at and to open.

    Everything on the left is sized by share of the height rather than in
    fixed amounts, so the same file fits a television and a phone held
    sideways without anything running off the bottom.
-->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="10dp" android:layout_weight="1" android:baselineAligned="false" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="35" android:orientation="vertical">
            <LinearLayout android:id="@+id/tileLive" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.25" android:background="@drawable/bg_home_row" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="12dp">
                <FrameLayout android:id="@+id/liveChip" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_home_chip" android:duplicateParentState="true">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="11dp" android:contentDescription="@string/live_tv" android:src="@drawable/ic_live"/>
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tileLiveLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:letterSpacing="0.04" android:maxLines="1" android:text="@string/live_tv" android:textAllCaps="true" android:textColor="#FFFFFFFF" android:textSize="24sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/homeLiveCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:duplicateParentState="true" android:ellipsize="end" android:maxLines="1" android:textColor="@color/home_row_sub" android:textSize="13sp" android:visibility="gone"/>
                </LinearLayout>
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:duplicateParentState="true" android:importantForAccessibility="no" android:src="@drawable/ic_chevron" android:tint="@color/home_row_sub"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/tileSeries" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.25" android:layout_marginTop="10dp" android:background="@drawable/bg_home_row" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="12dp">
                <FrameLayout android:id="@+id/seriesChip" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_home_chip" android:duplicateParentState="true">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="11dp" android:contentDescription="@string/series" android:src="@drawable/ic_series"/>
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tileSeriesLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:letterSpacing="0.04" android:maxLines="1" android:text="@string/series" android:textAllCaps="true" android:textColor="#FFFFFFFF" android:textSize="24sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/homeSeriesCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:duplicateParentState="true" android:ellipsize="end" android:maxLines="1" android:textColor="@color/home_row_sub" android:textSize="13sp" android:visibility="gone"/>
                </LinearLayout>
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:duplicateParentState="true" android:importantForAccessibility="no" android:src="@drawable/ic_chevron" android:tint="@color/home_row_sub"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/tileMovies" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.25" android:layout_marginTop="10dp" android:background="@drawable/bg_home_row" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="12dp">
                <FrameLayout android:id="@+id/moviesChip" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_home_chip" android:duplicateParentState="true">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="11dp" android:contentDescription="@string/movies" android:src="@drawable/ic_movies"/>
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tileMoviesLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:letterSpacing="0.04" android:maxLines="1" android:text="@string/movies" android:textAllCaps="true" android:textColor="#FFFFFFFF" android:textSize="24sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/homeMoviesCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:duplicateParentState="true" android:ellipsize="end" android:maxLines="1" android:textColor="@color/home_row_sub" android:textSize="13sp" android:visibility="gone"/>
                </LinearLayout>
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:duplicateParentState="true" android:importantForAccessibility="no" android:src="@drawable/ic_chevron" android:tint="@color/home_row_sub"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="0.8" android:baselineAligned="false" android:orientation="horizontal">
                <LinearLayout android:id="@+id/homeEpg" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_action_button" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="8dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:duplicateParentState="true" android:importantForAccessibility="no" android:src="@drawable/ic_epg" android:tint="@color/home_icon_tint"/>
                    <TextView android:id="@+id/homeEpgLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:text="@string/tv_guide" android:textColor="@color/text_primary" android:textSize="14sp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/homeMultiview" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/bg_action_button" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="8dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:duplicateParentState="true" android:importantForAccessibility="no" android:src="@drawable/ic_multiview" android:tint="@color/home_icon_tint"/>
                    <TextView android:id="@+id/homeMultiviewLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:text="@string/multiview" android:textColor="@color/text_primary" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="0.8" android:baselineAligned="false" android:orientation="horizontal">
                <LinearLayout android:id="@+id/homeRecordings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_action_button" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="8dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:duplicateParentState="true" android:importantForAccessibility="no" android:src="@drawable/ic_record" android:tint="@color/home_icon_tint"/>
                    <TextView android:id="@+id/homeRecordingsLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:text="@string/recordings" android:textColor="@color/text_primary" android:textSize="14sp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/homeSearch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/bg_action_button" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="8dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:duplicateParentState="true" android:importantForAccessibility="no" android:src="@drawable/ic_search" android:tint="@color/home_icon_tint"/>
                    <TextView android:id="@+id/homeSearchLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:text="@string/search_hint" android:textColor="@color/text_primary" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="0.8" android:baselineAligned="false" android:orientation="horizontal">
                <LinearLayout android:id="@+id/homeRefresh" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_action_button" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="8dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:duplicateParentState="true" android:importantForAccessibility="no" android:src="@drawable/ic_refresh" android:tint="@color/home_icon_tint"/>
                    <TextView android:id="@+id/homeRefreshLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:text="@string/home_refresh" android:textColor="@color/text_primary" android:textSize="14sp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/homeSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/bg_action_button" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="8dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:duplicateParentState="true" android:importantForAccessibility="no" android:src="@drawable/ic_settings" android:tint="@color/home_icon_tint"/>
                    <TextView android:id="@+id/homeSettingsLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:text="@string/settings" android:textColor="@color/text_primary" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:id="@+id/featuredPanel" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="12dp" android:layout_weight="65" android:background="@drawable/bg_poster_card" android:clickable="true" android:focusable="true" android:foreground="@drawable/fg_card_press">
            <ImageView android:id="@+id/featuredArt" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/featured" android:scaleType="centerCrop"/>
            <TextView android:id="@+id/featuredTag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_margin="16dp" android:background="@drawable/bg_home_tag" android:fontFamily="sans-serif-medium" android:letterSpacing="0.08" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:text="@string/home_recently_added" android:textAllCaps="true" android:textColor="#FFFFFFFF" android:textSize="12sp" android:visibility="gone"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="@drawable/bg_card_label" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="54dp" android:paddingBottom="16dp">
                <TextView android:id="@+id/featuredTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:breakStrategy="simple" android:ellipsize="end" android:hyphenationFrequency="none" android:letterSpacing="0.03" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="28sp" android:textStyle="bold"/>
                <TextView android:id="@+id/featuredMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end" android:maxLines="1" android:textColor="#FFE2E8EF" android:textSize="15sp"/>
                <TextView android:id="@+id/featuredHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_home_hint" android:fontFamily="sans-serif-medium" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:text="@string/home_press_ok" android:textColor="#FFFFFFFF" android:textSize="13sp" android:visibility="gone"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
