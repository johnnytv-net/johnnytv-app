<?xml version="1.0" encoding="utf-8"?>
<!-- The second line of a home row: grey at rest, white on the blue of a focused row. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#FFFFFFFF" />
    <item android:state_pressed="true" android:color="#FFFFFFFF" />
    <item android:color="@color/text_secondary" />
</selector>
